        ],
        "lineageTag": "a74946aa-9d4b-4331-a372-4d66efc71835",
        "measures": [
          {
            "name": "Registros originales",
            "expression": "COUNTROWS('Agricultura')",
            "formatString": "#,##0",
            "lineageTag": "8b860677-a2ab-434d-ac07-be74a971dda8"
          },
          {
            "name": "Registros analiticos",
            "expression": "CALCULATE(COUNTROWS('Agricultura'), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "13496cac-c868-405d-b61d-11a8a6ca6634"
          },
          {
            "name": "Produccion tn",
            "expression": "CALCULATE(SUM('Agricultura'[produccion_tn]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "d571f977-45e6-4ca2-93d1-191be63e96eb"
          },
          {
            "name": "Superficie cosechada ha",
            "expression": "CALCULATE(SUM('Agricultura'[sup_cosechada_ha]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "4f5f0310-e39c-41ea-ac0d-f86c9c592924"
          },
          {
            "name": "Superficie sembrada ha",
            "expression": "CALCULATE(SUM('Agricultura'[sup_sembrada_ha]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "79bf8296-1392-4e86-ad73-02971f5ebc59"
          },
          {
            "name": "Rendimiento ponderado kg ha",
            "expression": "DIVIDE([Produccion tn] * 1000, [Superficie cosechada ha])",
            "formatString": "#,##0.0",
            "lineageTag": "83ae33b1-d18e-4acf-b0d3-d35f3ce0e3b6"
          },
          {
            "name": "Tasa cosecha porcentaje",
            "expression": "DIVIDE([Superficie cosechada ha], [Superficie sembrada ha])",
            "formatString": "0.0%",
            "lineageTag": "f6189b1a-a888-480e-a64c-37057208cd97"
          },
          {
            "name": "Cultivos distintos",
            "expression": "CALCULATE(DISTINCTCOUNT('Agricultura'[cultivo]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "57ff9c57-878b-4bb9-8735-f1c279ca1cf6"
          },
          {
            "name": "Provincias distintas",
            "expression": "CALCULATE(DISTINCTCOUNT('Agricultura'[provincia]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "d6b741ac-7a8c-4485-840d-cbd1ac26ac59"
          },
          {
            "name": "Produccion millones tn",
            "expression": "DIVIDE([Produccion tn], 1000000)",
            "formatString": "#,##0.0",
            "lineageTag": "d2e287b0-e743-4c3c-9b72-9bdd61e02d7e"
          },
          {
            "name": "Participacion produccion",
            "expression": "DIVIDE([Produccion tn], CALCULATE([Produccion tn], ALLSELECTED('Agricultura'[cultivo])))",
            "formatString": "0.0%",
            "lineageTag": "168989a3-328c-4816-9ef7-29e5a046ecc7"
          },
          {
            "name": "Registros winsorizados",
            "expression": "CALCULATE(COUNTROWS('Agricultura'), 'Agricultura'[rend_winsorizado] = TRUE(), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "02afef63-bfed-4cd1-aeaf-2f59c187a909"
          },
          {
            "name": "Temperatura media C",
            "expression": "CALCULATE(AVERAGE('Agricultura'[temperatura_c]), 'Agricultura'[sup_cosechada_ha] > 0, 'Agricultura'[produccion_tn] > 0, 'Agricultura'[sup_imputada] = FALSE())",
            "formatString": "0.0",
            "lineageTag": "7a14d9d0-3d42-405e-bafc-9e444a86d70c"
          }
        ],
        "partitions": [
          {
            "name": "Agricultura",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fuente = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/CarlsdeLeon/Data-Sience-Final-Project/main/data/agricultura_final.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"id_provincia\", Int64.Type}, {\"provincia\", type text}, {\"id_departamento\", Int64.Type}, {\"departamento\", type text}, {\"id_cultivo\", Int64.Type}, {\"cultivo\", type text}, {\"id_campana\", Int64.Type}, {\"campana\", type text}, {\"temperatura_c\", Int64.Type}, {\"sup_sembrada_ha\", type number}, {\"sup_cosechada_ha\", type number}, {\"produccion_tn\", Int64.Type}, {\"rendimiento_kg_ha\", type number}, {\"calidad\", type text}, {\"anio_inicio\", Int64.Type}, {\"clave_departamento\", type text}, {\"id_fila\", Int64.Type}, {\"sup_imputada\", type logical}, {\"rendimiento_wins_kg_ha\", type number}, {\"rend_winsorizado\", type logical}}, \"en-US\")",
                "in",
                "    Tipos"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}